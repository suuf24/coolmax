# Release signing credentials for CoolMax.
#
# Copy to `keystore.properties` in the project root and fill in the real values. The file is
# gitignored on purpose: a release keystore and its passwords must never be committed.
#
# storeFile is resolved relative to the app module directory.
storeFile=coolmax-release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
