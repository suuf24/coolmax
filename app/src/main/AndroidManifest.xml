<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Strictly NO INTERNET permission for privacy & offline guarantee -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility for the per-app governor and screen-off freeze pickers: only launchable
         apps, launchers and input methods are visible, so no QUERY_ALL_PACKAGES permission is
         required. Launchers and IMEs are resolved so the app freeze can always exclude them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name=".CoolMaxApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoolMax">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CoolMax">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Service for Screen-Off & Trigger Monitoring.
             Note: ACTION_SCREEN_OFF and ACTION_SCREEN_ON are registered dynamically inside this service. -->
        <service
            android:name=".service.ScreenOffGuardService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="root_cpu_frequency_screen_off_profile_guard" />
        </service>

        <!-- Boot Receiver: Waits for BOOT_COMPLETED + 60s safety delay before auto-apply -->
        <receiver
            android:name=".service.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Tile for toggling Screen-Off Profile -->
        <service
            android:name=".service.ScreenOffTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_lock_idle_lock"
            android:label="@string/tile_screen_off_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Homescreen AppWidget for active profile & quick switch -->
        <receiver
            android:name=".service.CoolMaxWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="id.coolmax.app.ACTION_WIDGET_CYCLE_PRESET" />
                <action android:name="id.coolmax.app.ACTION_WIDGET_TOGGLE_SCREEN_OFF" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/coolmax_widget_info" />
        </receiver>

    </application>

</manifest>
