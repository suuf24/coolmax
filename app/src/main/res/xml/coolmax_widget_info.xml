<?xml version="1.0" encoding="utf-8"?>
<!-- previewLayout/targetCellWidth/targetCellHeight/description are Android 12+; they are ignored
     on older releases, where initialLayout is used instead. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_name"
    android:initialLayout="@layout/widget_coolmax"
    android:minWidth="250dp"
    android:minHeight="60dp"
    android:previewLayout="@layout/widget_coolmax"
    android:resizeMode="horizontal"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
